# Bare-metal alternative to the compose file: a token-protected mcpify
# HTTP endpoint as a systemd service.
#
#   sudo cp mcpify.service /etc/systemd/system/
#   sudo systemctl edit mcpify   # set Environment=MCPIFY_HTTP_TOKEN=...
#   sudo systemctl enable --now mcpify

[Unit]
Description=mcpify — OpenAPI-to-MCP shared server (HTTP transport)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Put the real values here or via `systemctl edit`:
# Environment=MCPIFY_HTTP_TOKEN=change-me
# Environment=API_TOKEN=<credential for the upstream API, if any>
User=nobody
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ExecStart=/usr/local/bin/mcpify serve /etc/mcpify/openapi.json --http 0.0.0.0:8080 --http-token ${MCPIFY_HTTP_TOKEN} --read-only
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
